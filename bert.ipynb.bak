   "source": [
    "lr_results = []\n",
    "for lr in [1e-5, 2e-5, 3e-5]:\n",
    "    t = finetune(f\"lr{lr}\", domain_train, domain_val, epochs=3, lr=lr, cw_power=0.5)\n",
    "    m = t.evaluate()\n",
    "    lr_results.append({\"lr\": lr, \"val_macro_f1\": m[\"eval_macro_f1\"], \"val_accuracy\": m[\"eval_accuracy\"]})\n",
    "    cleanup(t)\n",
    "\n",
    "print(pd.DataFrame(lr_results).round(4).to_string(index=False))\n",
    "BEST_LR = max(lr_results, key=lambda r: r[\"val_macro_f1\"])[\"lr\"]\n",
    "print(\"Chon lr =\", BEST_LR)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Strategy 1 — Domain only  (= Model B)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "trainer_s1 = finetune(\"S1\", domain_train, domain_val, epochs=6, lr=BEST_LR, cw_power=0.5)\n",
    "plot_training(trainer_s1, \"S1 — Domain only\")\n",
    "pred_s1 = evaluate_bert(trainer_s1, domain_test, \"S1\")\n",
    "cleanup(trainer_s1)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Strategy 2 — Sequential transfer\n",
    "\n",
    "Giai doan 1 tren GoEmotions (= **Model A**), giai doan 2 fine-tune tiep tren StockEmotions.\n",
    "Phai cham diem giai doan 1 **truoc** khi chay giai doan 2."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "trainer_s2a = finetune(\"S2a\", general_train, general_val, epochs=3, lr=BEST_LR, cw_power=0.5)\n",
    "plot_training(trainer_s2a, \"S2a — General only\")\n",
    "pred_A = evaluate_bert(trainer_s2a, domain_test, \"S2a\")      # = Model A\n",
    "trainer_s2a.save_model(\"checkpoints/S2a/best\")\n",
    "cleanup(trainer_s2a)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "trainer_s2b = finetune(\"S2b\", domain_train, domain_val,\n",
    "                       init_from=\"checkpoints/S2a/best\", epochs=6, lr=BEST_LR, cw_power=0.5)\n",
    "plot_training(trainer_s2b, \"S2b — Sequential\")\n",
    "pred_s2 = evaluate_bert(trainer_s2b, domain_test, \"S2\")\n",
    "cleanup(trainer_s2b)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Strategy 3 — Mixed  (= Model C)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "mixed_train = pd.concat([general_train[[\"text\",\"label\"]],\n",
    "                         domain_train[[\"text\",\"label\"]]], ignore_index=True)\n",
    "print(\"mixed:\", len(mixed_train), \"| domain chiem\", f\"{len(domain_train)/len(mixed_train)*100:.1f}%\")\n",
    "\n",
    "trainer_s3 = finetune(\"S3\", mixed_train, domain_val, epochs=3, lr=BEST_LR, cw_power=0.5)\n",
    "plot_training(trainer_s3, \"S3 — Mixed\")\n",
    "pred_s3 = evaluate_bert(trainer_s3, domain_test, \"S3\")\n",
    "cleanup(trainer_s3)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Bang tong hop + confusion matrix"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "y = domain_test[\"label\"]\n",
    "rows = [(\"A  — General only (S2a)\",  len(general_train), pred_A),\n",
    "        (\"B  — Domain only (S1)\",    len(domain_train),  pred_s1),\n",
    "        (\"C  — Mixed (S3)\",          len(mixed_train),   pred_s3),\n",
    "        (\"S2 — Sequential transfer\", len(domain_train),  pred_s2)]\n",
    "\n",
    "summary = pd.DataFrame([{\"strategy\": n, \"train_size\": sz,\n",
    "                         \"macro_f1\": f1_score(y, p, average=\"macro\", zero_division=0),\n",
    "                         \"accuracy\": accuracy_score(y, p)} for n, sz, p in rows]).round(4)\n",
    "print(summary.to_string(index=False))\n",
    "summary.to_csv(\"results/summary_bert.csv\", index=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, ax = plt.subplots(figsize=(10, 9))\n",
    "ConfusionMatrixDisplay.from_predictions(y, pred_s2, xticks_rotation=45, cmap=\"Blues\", ax=ax, colorbar=False)\n",
    "ax.set_title(\"Confusion Matrix — S2 Sequential\")\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Phan mo rong\n",
    "\n",
    "Chi lam sau khi 3 chien luoc chinh da xong."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Seed ensemble: trung binh logits cua 3 seed\n",
    "for s in [1, 2]:\n",
    "    t = finetune(f\"S1_seed{s}\", domain_train, domain_val, epochs=6, lr=BEST_LR, cw_power=0.5, run_seed=s)\n",
    "    evaluate_bert(t, domain_test, f\"S1_seed{s}\")\n",
    "    cleanup(t)\n",
    "\n",
    "logits   = np.mean([np.load(f\"results/logits_{n}.npy\") for n in [\"S1\", \"S1_seed1\", \"S1_seed2\"]], axis=0)\n",
    "pred_ens = [id2label[i] for i in logits.argmax(-1)]\n",
    "print(f\"ENSEMBLE 3 seed | macro-F1 = {f1_score(y, pred_ens, average='macro', zero_division=0):.4f} \"f\"| accuracy = {accuracy_score(y, pred_ens):.4f}\")"
   ]
  },
  {
   "cell_type": "code",
