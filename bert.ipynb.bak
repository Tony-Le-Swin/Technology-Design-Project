    "t = finetune(\"S1_mean\", domain_train, domain_val, pooling=\"mean\", epochs=6, lr=BEST_LR, cw_power=0.5)\n",
    "pred_mean = evaluate_bert(t, domain_test, \"S1_mean\")\n",
    "cleanup(t)"
   ]
